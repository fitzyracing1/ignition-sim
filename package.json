{
  "name": "fakegreen01",
  "version": "1.0.0",
  "description": "fakegreen01 — Ignition simulator. Pure software ignition-timing simulator for learning/demo. NOT for controlling real engines or vehicles.",
  "license": "MIT",
  "author": "Joshua Almeida <fitzyracing1@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fitzyracing1/ignition-sim.git"
  },
  "homepage": "https://fitzyracing1.github.io/ignition-sim/",
  "bugs": {
    "url": "https://github.com/fitzyracing1/ignition-sim/issues"
  },
  "keywords": [
    "fakegreen",
    "fakegreen01",
    "ignition",
    "timing",
    "simulator",
    "spark-advance",
    "dwell",
    "education",
    "automotive-concepts"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NAMING.md",
    "FAKEGREEN-REGISTRY.md",
    "registry.json"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc -p tsconfig.json --noEmit",
    "fakegreen": "npx --yes fakegreen --fail-on high",
    "prepublishOnly": "npm run lint && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^5.6.0",
    "vite": "^6.4.3",
    "vitest": "^5.0.3"
  }
}
